	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=446687678901C540BB3EE09804B02B4A/Text/@EntryValue">if (!Osty.CheckMissingWithAnim(Owner))
        {
            await DamageCmd.Attack(DynamicVars.OstyDamage.BaseValue)
                .FromOsty(Owner.Osty!, this)
                .Targeting(play.Target)
                .WithAttackerAnim("attack_poke", 0.3f)
                .WithHitFx("vfx/vfx_attack_blunt", tmpSfx: "blunt_attack.mp3")
                .Execute(choiceContext);
        }</s:String>
